# Keystore e credenziali firma
*.keystore
*.jks
keystore.properties

# Google Services (contiene API key Firebase)
google-services.json

# Google Play API key
*.p12
play-store-credentials.json

# Variabili d'ambiente locali
.env
.env.*
local.properties

# ============================================================
# Android / Gradle
# ============================================================
.gradle/
build/
**/build/
*.apk
*.aab
*.ap_
*.dex

# Generati dall'IDE
.idea/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db

# Cartelle locali Android Studio
captures/
.externalNativeBuild/
.cxx/

# Kotlin
*.class

# ============================================================
# Node / npm (eventuale tooling web)
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*

# ============================================================
# Output CI/CD
# ============================================================
output-metadata.json
